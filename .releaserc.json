{
    "branches":  [
                     "master"
                 ],
    "plugins":  [
                    "@semantic-release/commit-analyzer",
                    "@semantic-release/release-notes-generator",
                    {
                        "value":  [
                                      "@semantic-release/exec",
                                      {
                                          "prepareCmd":  "python3 scripts/sync_pyproject_version.py ${nextRelease.version} core/pyproject.toml collector/pyproject.toml generator/pyproject.toml server/pyproject.toml charts/homelab-autodoc/Chart.yaml"
                                      }
                                  ],
                        "Count":  2
                    },
                    "@semantic-release/github"
                ]
}
