# Build contexts are the repo root (Dockerfiles COPY across package
# boundaries), so keep this broad - it applies to every image build.
.git/
.github/
.venv*/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
node_modules/
frontend/dist/
frontend/coverage/
**/site/
server/docs_src/
**/*.egg-info/
scripts/
